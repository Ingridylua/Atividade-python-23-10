# 4 exercício. Dicionário aninhado de alunos

turma = {
    "2026001": {"nome": "Ana", "nota": 8.5},
    "2026002": {"nome": "Bruno", "nota": 6.0},
    "2026003": {"nome": "Carla", "nota": 9.2}
}

soma = 0

for aluno in turma.values():
    nome = aluno["nome"]
    nota = aluno["nota"]

    if nota >= 7.0:
        situacao = "Aprovado"
    else:
        situacao = "Reprovado"

    print(nome, "- Nota:", nota, "- Situação:", situacao)

    soma = soma + nota

media = soma / len(turma)

print("Média geral:", media)


# 5 exercício. Análise de vendas

vendas = {
    "Janeiro": 12500,
    "Fevereiro": 9800,
    "Março": 15300,
    "Abril": 11700,
    "Maio": 18400
}

total = sum(vendas.values())
media = total / len(vendas)

maior = max(vendas, key=vendas.get)
menor = min(vendas, key=vendas.get)

print("Total vendido: R$", total)
print("Média mensal: R$", media)
print("Maior venda:", maior, "- R$", vendas[maior])
print("Menor venda:", menor, "- R$", vendas[menor])

print("Meses acima da média:")

for mes, valor in vendas.items():
    if valor > media:
        print(mes)

